{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Traceveil canonical event 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "session_id",
    "event_type"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "parent_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional RFC3339 timestamp. Invalid values cause partial coverage and a pattern boundary."
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "properties": {
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "arguments": {
          "type": [
            "object",
            "null"
          ]
        },
        "success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_complete": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
